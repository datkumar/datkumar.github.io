---
import SectionEntry from "../components/SectionEntry.astro";
import SectionTitle from "../components/SectionTitle.astro";
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout pageTitle="About">
  <div>
    <!-- EDUCATION -->
    <SectionTitle title="Education" />
    <SectionEntry
      headingLeft="Bachelor of Engineering, Information Technology"
      headingRight="2019 - 2023"
      subheadingLeft="Pune Institute of Computer Technology"
      subheadingRight="Pune"
      bulletPoints={[
        "Relevant coursework: DSA, OOP, OS, DBMS, LDCO, CNS, Discrete Math, AI, ML, DL, DSBDA, Distributed Systems",
      ]}
    />
    <br />
    <!-- WORK -->
    <SectionTitle title="Work Experience" />
    <SectionEntry
      headingLeft="Mobile Team Intern"
      headingRight="Dec '25 - Present"
      subheadingLeft="Griffyn Robotech"
      subheadingRight="Pune"
      bulletPoints={[
        "Contributed to building and refactoring Android applications built with React Native and Jetpack Compose",
        "Developed features and proof-of-concepts to support device tracking and testing workflows",
      ]}
    />
    <SectionEntry
      headingLeft="Project Technical Personnel"
      headingRight="Jan '25 - Jun '25"
      subheadingLeft="SCRC, IIIT Hyderabad"
      subheadingRight="Hyderabad"
      bulletPoints={[
        "Designed and implemented a Flutter application providing real-time visibility into campus IoT sensors, integrating Grafana dashboards, geospatial map layers, category-based data exploration, and configurable home-screen widgets",
        "Delivered smart-waste features including ANPR-driven pickup validation and camera-based ML waste-type classification to support automated waste-management workflows",
      ]}
    />
    <SectionEntry
      headingLeft="Website Development Intern"
      headingRight="May '24 - Nov '24"
      subheadingLeft="Sickrit Studio"
      subheadingRight="Remote"
      bulletPoints={[
        "Worked with UI/UX and design teams to build responsive, interactive web experiences for client campaigns.",
        "Integrated web animations using Lottie and Three.js to enhance engagement and visual appeal",
      ]}
    />
    <SectionEntry
      headingLeft="Product Engineer"
      headingRight="Sept '23 - Jan '24"
      subheadingLeft="BeyondWalls"
      subheadingRight="Pune"
      bulletPoints={[
        "Implemented a Video-Tour functionality in the app that allowed brokers to showcase property listings visually, thereby increasing reach and driving faster sales",
        "Developed a functional interactive prototype from scratch, complete with UI elements and intuitive user interactions, to demonstrate the potential of a new external app",
      ]}
    />
    <SectionEntry
      headingLeft="Product Engineer Intern"
      headingRight="Feb '23 - Aug '23"
      subheadingLeft="Kylas CRM"
      subheadingRight="Pune"
      bulletPoints={[
        "Successfully completed a two-month training program, acquiring a strong foundation in Flutter and best practices for writing maintainable code.",
        'Developed features such as "Quick Actions" and "Import Contacts" that significantly reduced user clicks and automated manual tasks, improving overall efficiency.',
      ]}
    />
    <SectionEntry
      headingLeft="Web Developer Intern"
      headingRight="Sept '22 - Feb '23"
      subheadingLeft="PICT & Huf India"
      subheadingRight="Remote"
      bulletPoints={[
        "Led a team of four developers in the development of an Industry 4.0 web-portal using the MERN stack, cloud deployments, and socket-based message passing",
        "Collaborated with cross-functional teams and the client to successfully implement digital transformation of existing paper-based processes",
        "Implemented streamlined notification rules and real-time dashboards to enhance efficiency, significantly reducing downtime and accelerating response times.",
      ]}
    />
    <br />
    <!-- VOLUNTEERING -->
    <SectionTitle title="Volunteering" />
    <SectionEntry
      headingLeft="Mentor"
      headingRight="Mar '23 - Apr '23"
      subheadingLeft="Dreamcatchers Club"
      subheadingRight="Pune"
      bulletPoints={[
        "Guided high-school students in software development, introducing them to various aspects of the field and facilitating the creation of mini-projects.",
      ]}
    />
    <SectionEntry
      headingLeft="Problem Curator"
      headingRight="Nov '21 - Feb '22"
      subheadingLeft="PCSB"
      subheadingRight="Remote"
      bulletPoints={[
        "Created challenging coding problems for college competitions. Monitored and ensured the integrity of coding contests, addressing any discrepancies in problems or test cases.",
      ]}
    />
  </div>
</PageLayout>
